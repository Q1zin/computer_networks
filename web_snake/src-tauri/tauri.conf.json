{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "snake",
  "version": "0.1.0",
  "identifier": "com.q1zin.snake",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "snake",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/128x128.png"
    ]
  }
}
